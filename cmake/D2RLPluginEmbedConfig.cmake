include_guard(GLOBAL)

function(d2rlplugin_embed_config)
	cmake_parse_arguments(PARSE_ARGV 0 D2RLCONFIG "" "TARGET;FILE" "")
	if(D2RLCONFIG_UNPARSED_ARGUMENTS)
		message(FATAL_ERROR "d2rlplugin_embed_config received unexpected arguments: ${D2RLCONFIG_UNPARSED_ARGUMENTS}")
	endif()
	if(NOT D2RLCONFIG_TARGET OR NOT D2RLCONFIG_FILE)
		message(FATAL_ERROR "d2rlplugin_embed_config requires TARGET and FILE.")
	endif()
	if(NOT TARGET "${D2RLCONFIG_TARGET}")
		message(FATAL_ERROR "d2rlplugin_embed_config target does not exist: ${D2RLCONFIG_TARGET}")
	endif()

	get_target_property(target_type "${D2RLCONFIG_TARGET}" TYPE)
	if(NOT target_type STREQUAL "SHARED_LIBRARY" AND NOT target_type STREQUAL "MODULE_LIBRARY")
		message(FATAL_ERROR "d2rlplugin_embed_config target must be a shared or module library: ${D2RLCONFIG_TARGET}")
	endif()

	get_filename_component(config_file "${D2RLCONFIG_FILE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
	if(NOT EXISTS "${config_file}" OR IS_DIRECTORY "${config_file}")
		message(FATAL_ERROR "d2rlplugin_embed_config file does not exist: ${config_file}")
	endif()

	file(SIZE "${config_file}" config_size)
	if(config_size EQUAL 0)
		message(FATAL_ERROR "d2rlplugin_embed_config file is empty: ${config_file}")
	endif()
	if(config_size GREATER 1048576)
		message(FATAL_ERROR "d2rlplugin_embed_config file is larger than 1 MiB: ${config_file}")
	endif()

	get_property(config_already_set TARGET "${D2RLCONFIG_TARGET}" PROPERTY D2RLPLUGIN_EMBEDDED_CONFIG SET)
	if(config_already_set)
		message(FATAL_ERROR "d2rlplugin_embed_config may only be called once for target ${D2RLCONFIG_TARGET}.")
	endif()
	set_property(TARGET "${D2RLCONFIG_TARGET}" PROPERTY D2RLPLUGIN_EMBEDDED_CONFIG "${config_file}")

	set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/d2rlplugin/${D2RLCONFIG_TARGET}")
	file(MAKE_DIRECTORY "${generated_dir}")

	set(embedded_config "${generated_dir}/default-config.toml")
	configure_file("${config_file}" "${embedded_config}" COPYONLY)
	file(TO_CMAKE_PATH "${embedded_config}" D2RLPLUGIN_EMBEDDED_CONFIG_PATH)

	set(resource_file "${generated_dir}/default-config.rc")
	configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/D2RLPluginConfigResource.rc.in" "${resource_file}" @ONLY)
	set_property(SOURCE "${resource_file}" APPEND PROPERTY OBJECT_DEPENDS "${embedded_config}")
	target_sources("${D2RLCONFIG_TARGET}" PRIVATE "${resource_file}")
endfunction()
