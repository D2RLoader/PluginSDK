{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 29,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "clang-cl",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_MAKE_PROGRAM": "C:/Program Files/LLVM/bin/ninja.exe",
				"CMAKE_CXX_COMPILER": "clang-cl",
				"CMAKE_LINKER_TYPE": "LLD",
				"CMAKE_AR": "lib.exe",
				"CMAKE_MT": "llvm-mt",
				"CMAKE_RC_COMPILER": "llvm-rc",
				"CMAKE_EXPORT_COMPILE_COMMANDS": true
			}
		},
		{
			"name": "debug",
			"inherits": "clang-cl",
			"binaryDir": "${sourceDir}/build/obj/debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"BUILD_TESTING": true
			}
		},
		{
			"name": "release",
			"inherits": "clang-cl",
			"binaryDir": "${sourceDir}/build/obj/release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"BUILD_TESTING": false
			}
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "debug-tests",
			"displayName": "Debug tests",
			"configurePreset": "debug",
			"targets": [
				"D2RLPluginTests"
			]
		}
	],
	"testPresets": [
		{
			"name": "debug",
			"displayName": "Debug tests",
			"configurePreset": "debug",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"jobs": 4,
				"noTestsAction": "error"
			}
		}
	],
	"workflowPresets": [
		{
			"name": "debug",
			"displayName": "Configure, build, and test Debug",
			"steps": [
				{
					"type": "configure",
					"name": "debug"
				},
				{
					"type": "build",
					"name": "debug-tests"
				},
				{
					"type": "test",
					"name": "debug"
				}
			]
		}
	]
}
